# RADAR + STUDIO Docker Compose Environment Variables
# Copy this file to .env and fill in the values

# Shared
SESSION_SECRET=change-me-use-openssl-rand-base64-32
GROQ_API_KEY=gsk_...
AUTH_PASSWORD=work

# Cookie de session (audit 2026-09-07, findings A1/A2) — laisser vide en dev.
# Une fois HTTPS actif en prod (setup-ssl.sh), définir les deux :
# SESSION_COOKIE_SECURE=true                  # cookie envoyé uniquement en HTTPS
# SESSION_COOKIE_DOMAIN=.media-labs.is-a.dev  # partage réel entre RADAR et STUDIO (sous-domaines)
SESSION_COOKIE_SECURE=
SESSION_COOKIE_DOMAIN=

# GOOGLE (optional — for Google Drive integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://radar.media-labs.is-a.dev/api/auth/google/callback
