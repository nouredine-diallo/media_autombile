{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist-worker",
    "noEmit": false,
    "strict": false,
    "allowJs": false
  },
  "include": ["src/pipeline-worker.ts"],
  "exclude": ["node_modules", ".next", "dist-worker"]
}
